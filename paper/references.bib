@article{lowe_methods_2024,
	title = {Methods to estimate the circular economy rebound effect: {A} review},
	volume = {443},
	issn = {0959-6526},
	shorttitle = {Methods to estimate the circular economy rebound effect},
	url = {https://www.sciencedirect.com/science/article/pii/S0959652624005109},
	doi = {10.1016/j.jclepro.2024.141063},
	abstract = {The transition to a circular economy can be undermined by rebound effects, which could mean secondary production does not fully displace virgin raw materials. So called ‘circular economy rebound’ is under examined in the academic literature and thus requires greater attention if it is to be successfully estimated and mitigated by decision and policy makers. Accordingly, this paper undertakes a systematic review of the methods that have been deployed to measure rebound effects of all types and identifies those quantitative tools that have yet to be utilised in the nascent area of circular economy rebound but which could have application in this context. In so doing, the paper also reflects on the data needs of different methods, as well as the magnitude of the different rebounds identified and potential mitigating strategies. Findings suggest clear research gaps within the rebound literature and identify areas in which estimation of the circular economy rebound specifically could benefit from this wider body of work on rebound assessment.},
	urldate = {2026-01-05},
	journal = {Journal of Cleaner Production},
	author = {Lowe, Benjamin H. and Bimpizas-Pinis, Meletios and Zerbino, Pierluigi and Genovese, Andrea},
	month = mar,
	year = {2024},
	keywords = {Eco-efficiency, Environmental policy, Jevons' paradox, Rebound mitigation policy, Resource efficiency, Sustainable consumption},
	pages = {141063},
	file = {Accepted Version:C\:\\Users\\danie\\Zotero\\storage\\TYTRWA53\\Lowe et al. - 2024 - Methods to estimate the circular economy rebound effect A review.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\danie\\Zotero\\storage\\L7WDPJSJ\\S0959652624005109.html:text/html},
}
